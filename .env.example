ROUTER_HOST=192.168.31.1
# Admin password of the router web interface (same as the Wi-Fi password only if you chose that during initial setup)
ROUTER_PASSWORD=
SCRAPE_INTERVAL=15
# How long Prometheus keeps the data
RETENTION=90d
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
# Telegram (alerts, disabled by default - see README): @BotFather token and chat id (e.g. 123456789, or -100... for groups)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

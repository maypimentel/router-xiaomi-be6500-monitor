apiVersion: 1
contactPoints:
  - orgId: 1
    name: telegram
    receivers:
      - uid: telegram-wan
        type: telegram
        settings:
          botToken: __TELEGRAM_BOT_TOKEN__
          chatid: "__TELEGRAM_CHAT_ID__"
          message: |
            {{ if eq .Status "firing" }}🔴 ALERTA{{ else }}🟢 RESOLVIDO{{ end }}
            {{ range .Alerts }}{{ .Labels.alertname }}
            {{ .Annotations.summary }}
            {{ end }}
policies:
  - orgId: 1
    receiver: telegram
    group_by: ["alertname"]
    group_wait: 10s
    repeat_interval: 4h
